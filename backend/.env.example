# ============================================================
# CRM ADS - VARIÁVEIS DE AMBIENTE
# ============================================================
# Copie este arquivo para .env e preencha com seus valores

# --- SERVIDOR ---
NODE_ENV=development
PORT=3001
API_SECRET=sua_chave_secreta_aqui_min_32_chars

# --- BANCO DE DADOS PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=crm_ads
DB_USER=postgres
DB_PASSWORD=sua_senha_postgres
DB_SSL=false

# --- REDIS ---
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# --- GOOGLE ADS ---
GOOGLE_ADS_DEVELOPER_TOKEN=seu_developer_token
GOOGLE_ADS_CLIENT_ID=seu_client_id.apps.googleusercontent.com
GOOGLE_ADS_CLIENT_SECRET=seu_client_secret
GOOGLE_ADS_REFRESH_TOKEN=seu_refresh_token
GOOGLE_ADS_CUSTOMER_ID=1234567890
GOOGLE_ADS_LOGIN_CUSTOMER_ID=1234567890

# --- GOOGLE ANALYTICS 4 ---
GA4_MEASUREMENT_ID=G-XXXXXXXXXX
GA4_API_SECRET=seu_ga4_api_secret

# --- META ADS ---
META_APP_ID=seu_app_id
META_APP_SECRET=seu_app_secret
META_ACCESS_TOKEN=seu_access_token_longo
META_AD_ACCOUNT_ID=act_1234567890
META_PIXEL_ID=seu_pixel_id
META_WEBHOOK_VERIFY_TOKEN=seu_token_verificacao_webhook

# --- JWT ---
JWT_SECRET=sua_chave_jwt_super_secreta
JWT_EXPIRES_IN=7d

# --- WHATSAPP ---
WHATSAPP_NUMBER=5511999999999
WHATSAPP_BUSINESS_API_TOKEN=seu_token_waba

# --- WEBHOOK ---
WEBHOOK_SECRET=seu_segredo_webhook

# --- FRONTEND ---
FRONTEND_URL=http://localhost:5173
